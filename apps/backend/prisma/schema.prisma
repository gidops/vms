// VMS Prisma schema. Enums mirror @vms/contracts so DB ↔ API ↔ UI never drift.
// Identity/Auth/Audit + Outbox underpin every domain module; domain models
// follow. Actor references on audit-style rows (approvedById, raisedById, …)
// are plain UUID columns (indexed) rather than FK relations to keep the User
// model from accruing a back-relation for every action.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums (kept in sync with packages/contracts/src/common/enums.ts)
// ---------------------------------------------------------------------------
enum Locale {
  EN
  FR
  AR
}

enum AuthProvider {
  LOCAL
  OIDC
}

enum VisitType {
  WALK_IN
  PRE_INVITED
  APPOINTMENT
}

enum VisitStatus {
  PENDING
  REVIEW_REQUESTED
  FLAGGED
  APPROVED
  DENIED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  EXPIRED
}

enum PassStatus {
  ISSUED
  ACTIVE
  RETURNED
  REVOKED
  EXPIRED
}

enum InvitationStatus {
  DRAFT
  SENT
  ACCEPTED
  EXPIRED
  REVOKED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

enum AlertType {
  SECURITY_REVIEW
  ADDITIONAL_INFO
  RESTRICTED_MATCH
}

enum GateEventType {
  QR_SCAN
  APPOINTMENT_VERIFY
  INVITATION_VERIFY
  ACCESS_GRANTED
  ACCESS_DENIED
}

enum AttendanceType {
  SHIFT_START
  SHIFT_END
  BREAK_START
  BREAK_END
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  IN_APP
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}

// ---------------------------------------------------------------------------
// Identity / Auth / Audit
// ---------------------------------------------------------------------------
model User {
  id                String       @id @default(uuid())
  email             String       @unique
  passwordHash      String? // null for SSO-only users
  authProvider      AuthProvider @default(LOCAL)
  externalSubjectId String?      @unique // e.g. Okta `sub`
  tenantId          String? // multi-tenant prep
  fullName          String
  firstName         String?
  lastName          String?
  phone             String?
  // S3 object key for the avatar (e.g. avatars/<id>/<uuid>.jpg). The public URL
  // is composed on the frontend from NEXT_PUBLIC_S3_BASE_URL — never stored here.
  avatarKey         String?
  timezone          String? // IANA-ish identifier for region/time preference
  assignedDesk      String? // VMC reception desk/location label
  // Per-channel notification toggles, e.g. { newInviteRequest, smDenied, ... }.
  notificationPrefs Json?
  isActive          Boolean      @default(true)
  preferredLocale   Locale       @default(EN)
  mfaEnabled        Boolean      @default(false)
  // When the user last opened Requests & Alerts. An inbox item is "unread" for
  // them if its updatedAt is newer than this; opening the page bumps it to now.
  lastInboxSeenAt   DateTime?
  // Set on every successful login (session start), shown on the admin user detail.
  lastLoginAt       DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  userRoles           UserRole[]
  sessions            Session[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  auditLogs           AuditLog[]
  host          Host?
  createdVisits Visit[]        @relation("VisitCreatedBy")
  authoredNotes Note[]
  deskQrsCreated DeskQr[]
  rfidCardsIssued   RfidCardAssignment[] @relation("RfidIssuedBy")
  rfidCardsReturned RfidCardAssignment[] @relation("RfidReturnedBy")

  @@index([tenantId])
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]
  userRoles       UserRole[]
}

model Permission {
  id          String  @id @default(uuid())
  key         String  @unique // e.g. "visit:approve"
  description String?

  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId     String
  roleId     String
  // Ordering for "first assigned role" → a user's default active role.
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Session {
  id         String    @id @default(uuid())
  userId     String
  userAgent  String?
  ip         String?
  // The role this session is currently acting as (scopes token permissions).
  activeRole String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @updatedAt
  revokedAt  DateTime?

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
}

/// Admin-issued password-reset link. The raw token travels only inside the
/// emailed link; at rest it is kept as a sha256 hash. Single-use, short expiry,
/// and a new request supersedes any outstanding one for the same user.
model PasswordResetToken {
  id          String    @id @default(uuid())
  userId      String
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  /// Admin who triggered the reset (plain id, no FK: admins may be deleted later).
  createdById String?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RefreshToken {
  id           String    @id @default(uuid())
  sessionId    String
  userId       String
  tokenHash    String    @unique
  family       String // rotation family; reuse of a used token revokes the family
  prevTokenId  String?
  replacedById String?
  expiresAt    DateTime
  usedAt       DateTime?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([family])
  @@index([userId])
}

model AuditLog {
  id            String   @id @default(uuid())
  actorUserId   String?
  action        String
  entityType    String
  entityId      String?
  eventType     String?
  correlationId String?
  ip            String?
  userAgent     String?
  metadata      Json?
  createdAt     DateTime @default(now())

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([correlationId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Domain
// ---------------------------------------------------------------------------
model Visitor {
  id           String   @id @default(uuid())
  fullName     String
  email        String   @unique
  phone        String? // encrypted at rest (application layer)
  nationalId   String? // encrypted at rest (application layer)
  organization String?
  photoUrl     String?
  // Preferred language for visitor-facing notifications. Defaults to EN until
  // captured (e.g. at invitation/registration time).
  preferredLocale Locale @default(EN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  visits    Visit[]
  ratings   Rating[]
  alerts    Alert[]
  rfidCards RfidCardAssignment[]
}

model Host {
  id         String   @id @default(uuid())
  userId     String   @unique
  department String?
  office     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitations Invitation[]
  visits      Visit[]
}

model Visit {
  id           String      @id @default(uuid())
  visitorId    String
  // Optional: walk-ins may not be visiting a named staff host.
  hostId       String?
  invitationId String?     @unique
  // Set ONLY for a true group visit — every guest of that group shares one
  // groupId so the group collapses to one VMC row and checks in together. Bulk
  // invites/walk-ins and lone guests are independent visits with groupId = null.
  groupId      String?
  // True when this visit belongs to a group visit (the group signal). groupName
  // and groupContact are the shared group display name and optional contact
  // (a free-text email or phone number).
  isGroupVisit Boolean    @default(false)
  groupName    String?
  groupContact String?
  // Human-friendly invite code (e.g. "5A19-795") generated for invites at
  // creation and encoded in the guest's QR. Null for walk-ins.
  referenceCode String?    @unique
  type         VisitType
  status       VisitStatus @default(PENDING)
  purpose      String
  // Per-visit floor/department selected at request time (distinct from Host.office).
  floor        String?
  riskLevel    RiskLevel?
  scheduledAt  DateTime?
  // Set when the visit's QR is validated at the gate (or auto-set at VMC check-in).
  gateValidatedAt DateTime?
  checkInAt    DateTime?
  checkOutAt   DateTime?
  approvedById String?
  deniedReason String?
  // Origin of the request: who logged it and from which station/channel.
  createdById  String?
  // Denormalized creator name, preserved if the creator's account is deleted.
  createdByName String?
  // Name and organisation typed at a walk-in QR self-registration. The public
  // form can't verify the email, so these (not the matched Visitor record)
  // identify who is actually on site.
  visitorNameAtVisit  String?
  organizationAtVisit String?
  source       String?     @default("VMC_STATION")
  // Intake answers (null = legacy visit created before the questions existed).
  // needsEvacuationAssist feeds the live Evacuation Roll; commsConsent is the
  // answer given at THIS visit (current opt-in status lives in CommsConsentEvent).
  needsEvacuationAssist Boolean?
  // When the answer is Yes: MOBILITY | VISUAL | HEARING | MEDICAL | OTHER
  // (contracts EVACUATION_ASSIST_TYPES), plus free text for OTHER.
  evacuationAssistTypes String[] @default([])
  evacuationAssistOther String?
  commsConsent          Boolean?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  visitor    Visitor     @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  host       Host?       @relation(fields: [hostId], references: [id], onDelete: Cascade)
  invitation Invitation? @relation(fields: [invitationId], references: [id])
  createdBy  User?       @relation("VisitCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  pass       Pass?
  rating     Rating?
  alerts     Alert[]
  notes      Note[]
  gateEvents GateEvent[]
  rfidCards  RfidCardAssignment[]

  @@index([status])
  @@index([visitorId])
  @@index([hostId])
  @@index([groupId])
  @@index([scheduledAt])
}

model Invitation {
  id           String           @id @default(uuid())
  hostId       String
  visitorEmail String
  status       InvitationStatus @default(DRAFT)
  qrCode       String           @unique
  token        String           @unique
  validFrom    DateTime
  validTo      DateTime
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  host  Host   @relation(fields: [hostId], references: [id], onDelete: Cascade)
  visit Visit?

  @@index([hostId])
}

model Pass {
  id         String     @id @default(uuid())
  visitId    String     @unique
  code       String     @unique
  status     PassStatus @default(ISSUED)
  issuedAt   DateTime   @default(now())
  expiresAt  DateTime?
  returnedAt DateTime?

  visit      Visit       @relation(fields: [visitId], references: [id], onDelete: Cascade)
  accessCard AccessCard?
}

model AccessCard {
  id         String    @id @default(uuid())
  cardNumber String    @unique
  // Zone/location the badge belongs to (e.g. "5th Floor - left wing"). Drives the
  // "Assign pass" dropdown grouping at check-in.
  zone       String?
  passId     String?   @unique
  assignedAt DateTime?
  returnedAt DateTime?
  isActive   Boolean   @default(true)

  pass Pass? @relation(fields: [passId], references: [id], onDelete: SetNull)

  @@index([zone])
}

model Rating {
  id        String   @id @default(uuid())
  visitId   String   @unique
  visitorId String
  score     Int // 1-5
  comment   String?
  createdAt DateTime @default(now())

  visit   Visit   @relation(fields: [visitId], references: [id], onDelete: Cascade)
  visitor Visitor @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  @@index([visitorId])
}

model Alert {
  id           String      @id @default(uuid())
  visitId      String?
  visitorId    String?
  type         AlertType   @default(SECURITY_REVIEW)
  level        RiskLevel
  status       AlertStatus @default(OPEN)
  reason       String
  category     String?
  raisedById   String?
  resolvedById String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  visit   Visit?   @relation(fields: [visitId], references: [id], onDelete: SetNull)
  visitor Visitor? @relation(fields: [visitorId], references: [id], onDelete: SetNull)
  notes   Note[]

  @@index([status])
  @@index([visitId])
}

// Freeform remarks attached to a visit request or an alert (the "Remarks/notes"
// and "Add Note" affordance). Polymorphic via nullable visit/alert FKs.
model Note {
  id      String  @id @default(uuid())
  visitId String?
  alertId String?
  // Author link is SetNull on user deletion; authorName is denormalized so the
  // note keeps its attribution even after the author's account is removed.
  authorId   String?
  authorName String   @default("")
  body       String
  createdAt  DateTime @default(now())

  visit  Visit? @relation(fields: [visitId], references: [id], onDelete: Cascade)
  alert  Alert? @relation(fields: [alertId], references: [id], onDelete: Cascade)
  author User?  @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([visitId])
  @@index([alertId])
}

model GateEvent {
  id              String        @id @default(uuid())
  visitId         String?
  gateId          String
  type            GateEventType
  operativeUserId String?
  result          String?
  metadata        Json?
  occurredAt      DateTime      @default(now())

  visit Visit? @relation(fields: [visitId], references: [id], onDelete: SetNull)

  @@index([gateId])
  @@index([occurredAt])
}

model ShiftAttendance {
  id                     String         @id @default(uuid())
  operativeUserId        String
  type                   AttendanceType
  // Reference/hash to an external biometric vault — never raw template data.
  fingerprintTemplateRef String?
  gateId                 String?
  recordedAt             DateTime       @default(now())

  @@index([operativeUserId])
  @@index([recordedAt])
}

model Notification {
  id           String              @id @default(uuid())
  userId       String?
  visitorEmail String?
  // Resolved delivery target for the channel (email address or phone number).
  // For IN_APP, recipient is the userId; for EMAIL/SMS/WHATSAPP it's the address.
  recipient    String?
  channel      NotificationChannel
  locale       Locale              @default(EN)
  templateKey  String
  payload      Json?
  // Lifecycle: PENDING -> SENT | FAILED. Drives the polling dispatcher.
  status       String              @default("PENDING")
  attempts     Int                 @default(0)
  availableAt  DateTime            @default(now())
  error        String?
  // Read receipt for IN_APP notifications (null = unread).
  readAt       DateTime?
  // Optional back-reference to the visit that triggered this notification.
  visitId      String?
  sentAt       DateTime?
  createdAt    DateTime            @default(now())

  @@index([status, availableAt])
  @@index([userId, readAt])
  @@index([visitId])
}

// ---------------------------------------------------------------------------
// Communication consent (NDPR accountability)
// ---------------------------------------------------------------------------
enum ConsentSource {
  VISIT
  WITHDRAWAL
  // Recorded by a System Admin on the visitor's behalf (opted back in).
  ADMIN
}

// Append-only log of every comms-consent answer, keyed on the normalised
// (trimmed, lower-cased) email. The current status for an email is its latest
// event; a withdrawal is a new event, so visit history is never rewritten.
model CommsConsentEvent {
  id          String        @id @default(uuid())
  email       String
  consent     Boolean
  source      ConsentSource
  visitId     String?
  actorUserId String?
  createdAt   DateTime      @default(now())

  @@index([email, createdAt])
  @@index([visitId])
}

// ---------------------------------------------------------------------------
// Event infrastructure (transactional outbox)
// ---------------------------------------------------------------------------
model OutboxEvent {
  id            String       @id @default(uuid())
  aggregateType String
  aggregateId   String
  eventType     String
  payload       Json
  metadata      Json?
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  availableAt   DateTime     @default(now())
  publishedAt   DateTime?
  createdAt     DateTime     @default(now())

  @@index([status, availableAt])
}

/// The one QR printed at the VMC desk. Visitors scan it, fill in a short form
/// and immediately become today's walk-ins — no desk verification step.
/// Only one row ever exists (`key` is always "desk").
model DeskQr {
  id             String    @id @default(uuid())
  key            String    @unique @default("desk")
  /// In the printed URL. New tokens are random base64url; an imported V1
  /// token keeps its 32-hex value so the poster already on the desk works.
  token          String    @unique
  isActive       Boolean   @default(true)
  disabledAt     DateTime?
  tokenRotatedAt DateTime  @default(now())
  /// Form opens in the WAT day `scanDay` (YYYY-MM-DD); resets on a new day.
  scanDay        String?
  scansToday     Int       @default(0)
  lastScanAt     DateTime?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)
}

enum RfidCardStatus {
  AVAILABLE
  ASSIGNED
  LOST
  RETIRED
}

enum RfidAssignmentStatus {
  ACTIVE
  RETURNED
  LOST
}

// A personalised RFID access card (Operations → Access cards). Another
// department configures its doors/floors; the System Admin team prints the
// visitor's photo and validity on it and assigns it here. NOT the visitor-pass
// badge pool (`AccessCard`) that reception hands out at check-in. A card is
// registered the first time its number is assigned and reused after return.
model RfidCard {
  id         String         @id @default(uuid())
  cardNumber String         @unique
  status     RfidCardStatus @default(AVAILABLE)
  notes      String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  assignments RfidCardAssignment[]

  @@index([status])
}

// One issue of an RFID card to a visitor for a validity window (may span many
// days). At most one ACTIVE assignment per card and per visitor (enforced in
// the service). Reception retrieves the card at check-out (VMC follow-up).
model RfidCardAssignment {
  id            String               @id @default(uuid())
  cardId        String
  visitorId     String
  // Optional visit the card was issued for (e.g. the current one).
  visitId       String?
  validFrom     DateTime
  validUntil    DateTime
  // S3 key of the visitor photo printed on the card (served via signed URL).
  photoKey      String?
  status        RfidAssignmentStatus @default(ACTIVE)
  issuedById    String?
  issuedAt      DateTime             @default(now())
  printCount    Int                  @default(0)
  lastPrintedAt DateTime?
  returnedAt    DateTime?
  returnedById  String?
  closeNote     String?
  notes         String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  card       RfidCard @relation(fields: [cardId], references: [id], onDelete: Restrict)
  visitor    Visitor  @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  visit      Visit?   @relation(fields: [visitId], references: [id], onDelete: SetNull)
  issuedBy   User?    @relation("RfidIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)
  returnedBy User?    @relation("RfidReturnedBy", fields: [returnedById], references: [id], onDelete: SetNull)

  @@index([cardId])
  @@index([visitorId])
  @@index([status])
}
