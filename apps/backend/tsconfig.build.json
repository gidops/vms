{
  "extends": "./tsconfig.json",
  // "scripts" holds ts-node one-offs (migrate-legacy); compiling them shifts
  // tsc's rootDir to the package root, which moves code to dist/src/ while
  // nest's asset copy stays at dist/ — breaking email template resolution.
  "exclude": ["node_modules", "test", "dist", "scripts", "**/*spec.ts"]
}
