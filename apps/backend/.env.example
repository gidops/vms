DATABASE_URL=
JWT_SECRET=
JWT_EXPIRES_IN=
PORT=
NODE_ENV=

# Seq structured-log / audit mirror (optional). When set, audit events are
# mirrored to Seq (PostgreSQL stays the source of truth). Leave blank to disable.
# Local host: http://localhost:5341 — Docker Compose network: http://seq:5341
SEQ_URL=
SEQ_API_KEY=

# S3 avatar uploads (optional in dev; presign route 400s if S3_BUCKET unset).
# AWS credentials come from the default chain (env vars locally, IAM role in prod).
AWS_REGION=
S3_BUCKET=
S3_PRESIGN_EXPIRY=

# ── Notifications ────────────────────────────────────────────────────────────
# Per-channel toggles. A disabled channel is never enqueued/sent; an enabled but
# unconfigured channel logs the message instead of failing. See docs/notifications.md.
EMAIL_ENABLED=false
SMS_ENABLED=false
WHATSAPP_ENABLED=false
INAPP_ENABLED=true
# Polling dispatcher + retry (Notification table is the durable queue).
NOTIFICATION_POLL_INTERVAL_MS=5000
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATIONS_DEFAULT_LOCALE=EN
# Frontend URL used to build the post-visit rating/feedback link.
APP_PUBLIC_URL=http://localhost:3000

# Email transport: EMAIL_PROVIDER = smtp | gmail | mailtrap | sendgrid.
# gmail/mailtrap/smtp share the nodemailer provider (connection resolved from the
# selector); sendgrid uses the HTTP API. Falls back to log if unconfigured. All
# transports' credentials can coexist here — flip EMAIL_PROVIDER to switch.
# EMAIL_FROM must be a sender the active account is authorized to send as.
EMAIL_PROVIDER=smtp
EMAIL_FROM=

# Generic/custom SMTP server.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Gmail (EMAIL_PROVIDER=gmail). Host/port/secure fixed to smtp.gmail.com:465;
# GMAIL_APP_PASSWORD is a Google App Password (requires 2FA on the account).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Mailtrap live sending (EMAIL_PROVIDER=mailtrap).
MAILTRAP_HOST=live.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USER=
MAILTRAP_PASS=

# SendGrid HTTP API (EMAIL_PROVIDER=sendgrid). The SG.* value is the API key.
SENDGRID_API_KEY=

# SMS via Twilio (this account also backs the WhatsApp `twilio` provider).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
# WhatsApp "from" may be a bare +E164 number; the transport prefixes "whatsapp:"
# automatically. For sandbox testing use the Twilio sandbox number (+14155238886)
# and have each recipient message the join code first.
TWILIO_WHATSAPP_FROM=

# WhatsApp transport: WHATSAPP_PROVIDER = twilio | meta (mirrors EMAIL_PROVIDER).
# - twilio: reuses the Twilio account above (BSP).
# - meta:   Meta WhatsApp Cloud API (direct Graph API, no middleman).
# Falls back to log when the chosen provider is unconfigured.
# WHATSAPP_USE_TEMPLATES=false sends free text (Twilio sandbox / 24h session
# window). Set true only once approved templates (HSM) exist — required for
# proactive production sends, else WhatsApp silently drops the message.
WHATSAPP_PROVIDER=twilio
WHATSAPP_USE_TEMPLATES=false
# Meta WhatsApp Cloud API (WHATSAPP_PROVIDER=meta). Token is a permanent
# system-user access token from your Meta app; phone-number-id is the WABA
# sending number's ID. Version defaults to v21.0.
META_WHATSAPP_ACCESS_TOKEN=
META_WABA_PHONE_NUMBER_ID=
META_GRAPH_API_VERSION=v21.0
