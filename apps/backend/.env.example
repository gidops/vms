DATABASE_URL=
JWT_SECRET=
JWT_EXPIRES_IN=
PORT=
NODE_ENV=

# Seq structured-log / audit mirror (optional). When set, audit events are
# mirrored to Seq (PostgreSQL stays the source of truth). Leave blank to disable.
# Local host: http://localhost:5341 — Docker Compose network: http://seq:5341
SEQ_URL=
SEQ_API_KEY=

# S3 avatar uploads (optional in dev; presign route 400s if S3_BUCKET unset).
# AWS credentials come from the default chain (env vars locally, IAM role in prod).
AWS_REGION=
S3_BUCKET=
S3_PRESIGN_EXPIRY=

# ── Notifications ────────────────────────────────────────────────────────────
# Per-channel toggles. A disabled channel is never enqueued/sent; an enabled but
# unconfigured channel logs the message instead of failing. See docs/notifications.md.
EMAIL_ENABLED=false
SMS_ENABLED=false
WHATSAPP_ENABLED=false
INAPP_ENABLED=true
# Polling dispatcher + retry (Notification table is the durable queue).
NOTIFICATION_POLL_INTERVAL_MS=5000
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATIONS_DEFAULT_LOCALE=EN
# Frontend URL used to build the post-visit rating/feedback link.
APP_PUBLIC_URL=http://localhost:3000

# Email transport: EMAIL_PROVIDER = smtp | sendgrid (falls back to log if unconfigured).
EMAIL_PROVIDER=smtp
EMAIL_FROM=
# SMTP (Gmail/Mailtrap/any). Gmail dev: host=smtp.gmail.com port=465 secure=true,
# user=<you@gmail.com> pass=<app password>.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# SendGrid (set EMAIL_PROVIDER=sendgrid).
SENDGRID_API_KEY=

# SMS + WhatsApp via Twilio (one account serves both). WhatsApp "from" may be a
# bare +E164 number; the transport prefixes "whatsapp:" automatically.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
