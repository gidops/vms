<mj-section padding="36px 40px 32px">
  <mj-column>
    <mj-text font-size="21px" font-weight="700" color="#007570" padding="0 0 16px">
      {{t 'email.passwordReset.heading'}}
    </mj-text>
    <mj-text>{{t 'email.common.greeting' name=userName}}</mj-text>
    <mj-text>{{t 'email.passwordReset.intro'}}</mj-text>
    <mj-button href="{{resetUrl}}">
      {{t 'email.passwordReset.cta'}}
    </mj-button>
    <mj-text>{{t 'email.passwordReset.expiry' minutes=expiresMinutes}}</mj-text>
    <mj-text color="#64748b">{{t 'email.passwordReset.ignore'}}</mj-text>
    <mj-text color="#64748b" padding="8px 0 0">
      {{t 'email.common.regards'}}<br />{{t 'email.common.team'}}
    </mj-text>
  </mj-column>
</mj-section>
