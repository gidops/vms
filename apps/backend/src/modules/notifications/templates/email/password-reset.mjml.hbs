<mj-section background-color="#ffffff" border-radius="8px" padding="24px">
  <mj-column>
    <mj-text font-size="22px" font-weight="bold" color="#1a1a2e">
      {{t 'email.passwordReset.heading'}}
    </mj-text>
    <mj-text>{{t 'email.common.greeting' name=userName}}</mj-text>
    <mj-text>{{t 'email.passwordReset.intro'}}</mj-text>
    <mj-button href="{{resetUrl}}" background-color="#1a1a2e" color="#ffffff" border-radius="6px" padding="16px 0">
      {{t 'email.passwordReset.cta'}}
    </mj-button>
    <mj-text>{{t 'email.passwordReset.expiry' minutes=expiresMinutes}}</mj-text>
    <mj-text color="#8a8a9a">{{t 'email.passwordReset.ignore'}}</mj-text>
  </mj-column>
</mj-section>
