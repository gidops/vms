<mj-section padding="36px 40px 32px">
  <mj-column>
    <mj-text font-size="21px" font-weight="700" color="#007570" padding="0 0 16px">
      {{t 'email.visitorArrived.heading'}}
    </mj-text>
    <mj-text>{{t 'email.common.greeting' name=hostName}}</mj-text>
    <mj-text>{{t 'email.visitorArrived.intro' visitorName=visitorName}}</mj-text>
    {{#if time}}
      <mj-text color="#64748b">{{t 'email.visitorArrived.details' time=time}}</mj-text>
    {{/if}}
    <mj-text color="#64748b" padding="8px 0 0">
      {{t 'email.common.regards'}}<br />{{t 'email.common.team'}}
    </mj-text>
  </mj-column>
</mj-section>
