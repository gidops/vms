<mj-section background-color="#ffffff" border-radius="8px" padding="24px">
  <mj-column>
    <mj-text font-size="22px" font-weight="bold" color="#1a1a2e">
      {{t 'email.deskQrCode.heading'}}
    </mj-text>
    <mj-text>{{t 'email.deskQrCode.intro' visitorName=visitorName organization=organization}}</mj-text>
    <mj-text font-size="34px" font-weight="bold" letter-spacing="6px" align="center" padding="16px 0">
      {{code}}
    </mj-text>
    <mj-text>{{t 'email.deskQrCode.readOut' time=expiresAt}}</mj-text>
    <mj-text color="#8a8a9a">{{t 'email.deskQrCode.notHere'}}</mj-text>
  </mj-column>
</mj-section>
