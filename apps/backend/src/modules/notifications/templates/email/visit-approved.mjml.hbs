<mj-section padding="36px 40px 32px">
  <mj-column>
    <mj-text font-size="21px" font-weight="700" color="#007570" padding="0 0 16px">
      {{t 'email.visitApproved.heading'}}
    </mj-text>
    <mj-text>{{t 'email.common.greeting' name=visitorName}}</mj-text>
    <mj-text>{{t 'email.visitApproved.intro'}}</mj-text>

    <mj-table css-class="vms-table" padding="4px 0 18px">
      <tr><td>{{t 'email.labels.visitorName'}}</td><td>{{visitorName}}</td></tr>
      <tr><td>{{t 'email.labels.visitDate'}}</td><td>{{visitDate}}</td></tr>
      <tr><td>{{t 'email.labels.time'}}</td><td>{{time}}</td></tr>
      <tr><td>{{t 'email.labels.purpose'}}</td><td>{{purpose}}</td></tr>
      <tr><td>{{t 'email.labels.host'}}</td><td>{{host}}</td></tr>
      <tr><td>{{t 'email.labels.uniqueCode'}}</td><td><span class="vms-code">{{code}}</span></td></tr>
    </mj-table>

    <mj-text>{{t 'email.visitApproved.qrInstruction'}}</mj-text>
    <mj-image src="cid:qr" width="180px" align="center" alt="QR" padding="4px 0 18px" />

    <mj-text>{{t 'email.visitApproved.instructions'}}</mj-text>
    <mj-text color="#64748b" padding="8px 0 0">
      {{t 'email.common.regards'}}<br />{{t 'email.common.team'}}
    </mj-text>
  </mj-column>
</mj-section>
