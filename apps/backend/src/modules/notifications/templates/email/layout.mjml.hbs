{{!--
  AATC email standard. Structure follows the approved reference template:
  white logo bar → mint canvas → centred white card → solid brand footer
  band → small print. Official brand guide colours:
    teal   #007570 (headings, footer band; #00332F for text on gold)
    green  #07AF8B (tints: canvas #e6f7f2, table rules #d4efe7)
    gold   #FFCA00 (CTA buttons, code chip tint #fff1c2)
  Header: Afreximbank–AATC lockup via {{logoUrl}} (APP_PUBLIC_URL), with a
  text-wordmark fallback. Bodies only provide inner sections; the chrome
  lives here and all content is centre-aligned.
--}}
<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Helvetica, Arial, sans-serif" />
      <mj-text align="center" font-size="15px" color="#334155" line-height="1.65" padding="0 0 14px" />
      <mj-button background-color="#FFCA00" color="#00332F" font-size="15px" font-weight="700" border-radius="8px" inner-padding="14px 44px" align="center" padding="8px 0 20px" />
      <mj-image padding="0" />
    </mj-attributes>
    <mj-style>
      .vms-table table { border-collapse: collapse; }
      .vms-table td { padding: 9px 12px; font-size: 14px; color: #1e293b; border-bottom: 1px solid #d4efe7; }
      .vms-table td:first-child { color: #64748b; white-space: nowrap; }
      .vms-code { display: inline-block; background: #fff1c2; color: #00332F; font-weight: 700; letter-spacing: 1px; padding: 3px 10px; border-radius: 6px; }
    </mj-style>
  </mj-head>
  <mj-body background-color="#e6f7f2">
    <mj-section full-width="full-width" background-color="#ffffff" padding="18px 0">
      <mj-column>
        {{#if logoUrl}}
          <mj-image src="{{logoUrl}}" alt="Afreximbank — African Trade Centre" width="250px" align="center" />
        {{else}}
          <mj-text align="center" font-size="20px" font-weight="700" color="#007570" padding="0">
            {{t 'brand.name'}}
          </mj-text>
        {{/if}}
      </mj-column>
    </mj-section>

    <mj-section padding="0"><mj-column><mj-spacer height="34px" /></mj-column></mj-section>

    <mj-wrapper background-color="#ffffff" border-radius="12px" padding="0">
      {{{content}}}
    </mj-wrapper>

    <mj-section padding="0"><mj-column><mj-spacer height="30px" /></mj-column></mj-section>

    <mj-section full-width="full-width" background-color="#007570" padding="26px 0">
      <mj-column>
        <mj-text align="center" font-size="15px" font-weight="700" color="#ffffff" padding="0 0 6px">
          {{t 'brand.name'}}
        </mj-text>
        <mj-text align="center" font-size="12px" color="#bfe4de" padding="0">
          {{t 'email.common.automated'}}
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="18px 0 32px">
      <mj-column>
        <mj-text align="center" font-size="12px" color="#64748b" padding="0">
          {{t 'email.common.footer' year=year}}
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
