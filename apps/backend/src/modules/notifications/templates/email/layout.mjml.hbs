<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Helvetica, Arial, sans-serif" />
      <mj-text font-size="14px" color="#3b3b4f" line-height="1.6" />
    </mj-attributes>
    <mj-style>
      .vms-table td { padding: 6px 10px; font-size: 14px; color: #3b3b4f; }
      .vms-table td:first-child { color: #8a8a9a; white-space: nowrap; }
    </mj-style>
  </mj-head>
  <mj-body background-color="#f4f4f7">
    <mj-section padding="24px 0 8px">
      <mj-column>
        <mj-text align="center" font-size="20px" font-weight="bold" color="#1a1a2e">
          {{t 'brand.name'}}
        </mj-text>
      </mj-column>
    </mj-section>

    {{{content}}}

    <mj-section padding="8px 0 24px">
      <mj-column>
        <mj-text align="center" font-size="12px" color="#9a9aab">
          {{t 'email.common.automated'}}
        </mj-text>
        <mj-text align="center" font-size="12px" color="#9a9aab">
          {{t 'email.common.footer' year=year}}
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
