{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      { "include": "shared/i18n/messages/**/*.json", "watchAssets": true },
      {
        "include": "modules/notifications/templates/**/*.hbs",
        "watchAssets": true
      }
    ],
    "watchAssets": true
  }
}
