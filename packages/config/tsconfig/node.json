{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "VMS Node (NestJS)",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "ES2023",
    "lib": ["ES2023"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "noUncheckedIndexedAccess": false,
    "isolatedModules": false
  }
}
